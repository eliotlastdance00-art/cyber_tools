#!/usr/bin/env bash
# cyber_tools · vpn/dev/bin/xray
# TEST üçin ýasama xray: diňe `xray x25519` goldaýar.
# Hakyky açar jübüti gerek bolsa: hakyky xray binanyny ulanyň.
set -euo pipefail
if [[ ${1:-} == x25519 ]]; then
  if command -v openssl >/dev/null 2>&1; then
    priv=$(openssl rand -base64 32 | tr -d '\n=+/' | cut -c1-43)
    pub=$(printf '%s' "$priv" | openssl dgst -sha256 -binary | base64 | tr -d '\n=+/' | cut -c1-43)
  else
    priv="mockPrivateKey$(date +%s)AAAAAAAAAAAAAAAAAAAAAAAA"
    pub="mockPublicKey$(date +%s)BBBBBBBBBBBBBBBBBBBBBBBBB"
  fi
  printf 'PrivateKey: %s\n' "$priv"
  printf 'Password (PublicKey): %s\n' "$pub"
  printf 'Hash32: %s\n' "$(printf '%s' "$pub" | md5sum | awk '{print $1}')"
  exit 0
fi
echo "mock xray: diňe 'x25519' goldanýar" >&2
exit 1
